#, python-format
msgid "%(company)s · %(product)s · %(ref)s"
msgstr "%(company)s · %(product)s · %(ref)s"

msgid ""
"Company, product and eSIM flag can't be changed here. If those need fixing, "
"delete this entry and create a new one."
msgstr ""
"لا يمكن تغيير الشركة أو المنتج أو خيار eSIM هنا. للتصحيح، احذف الإدخال و"
"أنشئ واحداً جديداً."
msgid "Review and manage recorded sales."
msgstr "مراجعة وإدارة المبيعات المسجّلة."

msgid "Reject this sale? Supplier balance will be restored."
msgstr "رفض هذا البيع؟ سيتم استرجاع رصيد المورّد."

msgid "No sales awaiting approval."
msgstr "لا توجد مبيعات بانتظار الموافقة."

msgid "Copy"
msgstr "نسخ"

