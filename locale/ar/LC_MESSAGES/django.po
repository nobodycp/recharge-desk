msgstr "كشف خصومات ليان (.xlsx)"

msgid "Pending portal credits (optional)"
msgstr "أرصدة معلّقة على البوابة (اختياري)"

msgid ""
"One line per entry: phone,credit amount not yet shown on the export (e.g. "
"pending reversal)."
msgstr ""
"سطر لكل رقم: رقم_الهاتف,مبلغ_الإرجاع غير الظاهر بعد في الكشف (مثل عكس معلّق)."

msgid "Minimum difference to show"
msgstr "أقل فرق للعرض"

msgid ""
"Used for settlements (charge + disconnect retained amount) and for sales "
"differences between Layan and the system. Rows with a smaller difference are "
"hidden (0 shows all)."
msgstr ""
"يُستخدم للتسويات (المبلغ المتبقي بعد شحن وفصل) ولاختلاف المبيعات بين ليان "
"والنظام. الصفوف ذات الفرق الأصغر تُخفى (0 = عرض الكل)."

msgid "Below this amount counts as matched. Use 0 to show all."
msgstr "تحت هذا المبلغ يُحسب متطابقاً. استخدم 0 لعرض كل الفروقات."
msgid "Date to must be on or after date from."
msgstr "'تاريخ من' يجب أن يكون قبل أو يساوي 'تاريخ إلى'."

msgid "Package period"
msgstr "مدة الباقة"

msgid "Monthly (30 days) — default"
msgstr "شهري (30 يوماً) — افتراضي"

msgid "3 months (90 days)"
msgstr "3 أشهر (90 يوماً)"

msgid "Leave as monthly unless this package is a 3-month offer."
msgstr "اتركها شهرياً إلا إذا كانت الباقة عرض ثلاثة أشهر."

msgid "e.g. 100 GB"
msgstr "مثلاً 100 جيجا"

msgid "Pending credit (manual)"
msgstr "رصيد معلّق (يدوي)"

msgid "In system, not in Layan"
msgstr "مسجّل بالنظام وغير مسجّل بليان"

msgid "Settlement on disconnected number"
msgstr "تسوية على رقم مفصول"

msgid "Logged under another supplier"
msgstr "مسجّل تحت مورد آخر"

msgid "In Layan, not in system"
msgstr "مسجّل بليان وغير مسجّل بالنظام"

msgid "Matched"
msgstr "متطابق"

msgid "Sales difference (Layan vs system)"
msgstr "اختلاف مبيعات (ليان مقابل النظام)"

#, python-format
msgid ""
"In Layan for %(amount)s — no matching sale in the system for this period."
msgstr "في ليان بمبلغ %(amount)s — لا مبيع مطابق في النظام لهذه الفترة."
#, python-format
msgid "In the system for %(amount)s — not found on the uploaded Layan report."
msgstr "في النظام بمبلغ %(amount)s — غير موجود في كشف ليان المرفوع."
#, python-format
msgid "Charged on Layan (%(layan)s) but logged under %(suppliers)s."
msgstr "مخصوم في ليان (%(layan)s) لكنه مسجّل تحت %(suppliers)s."
msgid ""
"Charge + disconnect settlement on Layan. Review retained amount; it is "
"included in estimated deficit."
msgstr "تسوية شحن+فصل في ليان. راجع المبلغ المحفوظ؛ وهو داخل العجز المقدّر."
#, python-format
msgid "Layan cost %(layan)s is higher than system %(rd)s by %(gap)s."
msgstr "تكلفة ليان %(layan)s أعلى من النظام %(rd)s بمقدار %(gap)s."
#, python-format
msgid "System cost %(rd)s is higher than Layan %(layan)s by %(gap)s."
msgstr "تكلفة النظام %(rd)s أعلى من ليان %(layan)s بمقدار %(gap)s."
msgid "Layan and system costs match within the minimum difference."
msgstr "تكاليف ليان والنظام متطابقة ضمن الحد الأدنى للفرق."
msgid "name"
msgstr "الاسم"
msgid "icon"
msgstr "الأيقونة"

msgid "Shown on the employee sales screen instead of the name."
msgstr "تظهر في شاشة مبيعات الموظف بدلاً من الاسم."

msgid "opening balance"
msgstr "الرصيد الافتتاحي"
msgid "current balance"
msgstr "الرصيد الحالي"
