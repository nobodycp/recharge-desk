# =============================================================================
# Django — required in production
# =============================================================================
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=0

# Comma-separated host list. Must list every hostname that hits this app.
DJANGO_ALLOWED_HOSTS=prosim.ps,s.prosim.ps,rn.prosim.ps

# Comma-separated CSRF origins; MUST be https:// in production.
DJANGO_CSRF_TRUSTED_ORIGINS=https://prosim.ps,https://s.prosim.ps,https://rn.prosim.ps

# =============================================================================
# Database
# =============================================================================
# Preferred: a single connection URL (this is what Coolify provides for its
# managed Postgres service). Example:
#   postgres://user:pass@host:5432/dbname
DATABASE_URL=postgres://user:pass@db:5432/recharge

# Optional fallback (used only when DATABASE_URL is NOT set):
# POSTGRES_DB=recharge
# POSTGRES_USER=recharge
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=300
# POSTGRES_SSLMODE=

# (The shared cache switches to Redis automatically when REDIS_URL is set — see
# "Redis / Celery / provider gateway" below.)

# =============================================================================
# HTTPS / proxy
# =============================================================================
# Coolify terminates TLS at its proxy; leave 0 so gunicorn does not loop-redirect.
DJANGO_SECURE_SSL_REDIRECT=0
# Trust CF-Connecting-IP / X-Forwarded-For for client IP (default on in production).
# TRUST_X_FORWARDED_FOR=1
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=0

# =============================================================================
# Gunicorn (optional tuning; defaults are fine)
# =============================================================================
# PORT=8000
# GUNICORN_WORKER_CLASS=gthread
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=60
# WHITENOISE_MAX_AGE=2592000

# =============================================================================
# Redis / Celery / provider gateway
# =============================================================================
# Production only (settings refuse to boot without it) — leave unset for local
# eager Celery + in-process fakeredis mode. Internal Coolify Redis URL:
#   redis://:PASSWORD@redis:6379/0
# Used for: Celery broker, provider login sessions + locks, rate limits, cache.
# REDIS_URL=redis://:replace-me@redis:6379/0

# REQUIRED in production. Fernet key that encrypts provider accounts in the DB.
# Generate once and keep it safe (losing it means re-entering provider accounts):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_SECRETS_KEY=replace-me-with-a-generated-fernet-key

# 1 (default) = public refresh is queued to the worker and the page polls.
# 0 = emergency rollback to the old synchronous path (also use during first
# rollout, see DEPLOY_COOLIFY.md).
REFRESH_ASYNC_ENABLED=1

# Worker service only: celery concurrency (default 4).
# CELERY_CONCURRENCY=4

# Days to keep provider operation rows (management report "تقارير المزودين").
# Purged daily by the worker. Default 90; empty = default.
# PROVIDER_OPERATIONS_RETENTION_DAYS=90

# Sky Sales Portal (sales-ps.sky5g.ps) — ONE-TIME import only. A migration copies
# these into the encrypted provider account on first deploy; afterwards manage
# the account in the admin screen (Phone Refresh -> Providers -> Sky) and these
# variables are ignored once it is saved. Safe to remove after the first deploy.
# SKY_SALES_USER=your_sales_portal_username
# SKY_SALES_PASSWORD=your_sales_portal_password
# SKY_SALES_TOTP_SECRET=XXXXXXXXXXXXXXXX
# SKY_SALES_OTP_AUTH_URI=otpauth://totp/Sky:user?secret=XXXX&issuer=Sky
# Sticky residential proxy (Geonix example):
# SKY_SALES_PROXY=http://LOGIN_s_skysales:PASSWORD@res.geonix.com:10000

# =============================================================================
# Misc
# =============================================================================
# DJANGO_LOG_LEVEL=INFO
# DJANGO_STATIC_ROOT=/app/staticfiles
# DJANGO_MEDIA_ROOT=/app/media
# DJANGO_ASSET_CACHE_BUSTER=
