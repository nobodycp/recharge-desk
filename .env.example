# =============================================================================
# TEMPLATE ONLY — not a runtime config file. Copy to a real ``.env`` (or use
# systemd EnvironmentFile= pointing at a private path), then fill values there.
# NEVER commit real secrets; NEVER store secrets in this ``.env.example`` file.
# A future installer should generate the private ``.env``, not overwrite this
# template in the repository.
#
# TRUST: Production Django trusts X-Forwarded-* from a trusted reverse proxy
# (e.g. Caddy). Do not expose Gunicorn to the public internet — bind to
# 127.0.0.1 or a Unix socket only. See README “Reverse proxy trust”.
# =============================================================================
#
# --- Django (production: config.settings.production) -----------------------
#
# Required in production:
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=s.prosim.ps
DJANGO_CSRF_TRUSTED_ORIGINS=https://s.prosim.ps
#
# Optional:
# DJANGO_STATIC_ROOT=/var/www/recharge-desk/staticfiles
# DJANGO_MEDIA_ROOT=/var/www/recharge-desk/media
# DJANGO_LOG_LEVEL=INFO
#
# Only if you terminate TLS in Django (unusual with Caddy). Default is off;
# Caddy should redirect HTTP→HTTPS and set X-Forwarded-Proto.
# DJANGO_SECURE_SSL_REDIRECT=false
#
# HSTS: enable only after HTTPS works end-to-end (seconds, e.g. 31536000).
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
#
# --- PostgreSQL -------------------------------------------------------------
#
POSTGRES_DB=recharge_desk
POSTGRES_USER=recharge_desk
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60
# POSTGRES_SSLMODE=require
#
# --- Development only (config.settings.development) -------------------------
#
# DJANGO_SECRET_KEY=optional-override
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
