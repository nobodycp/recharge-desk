# Example systemd unit: /etc/systemd/system/recharge-desk.service
# Adjust User, Group, WorkingDirectory, EnvironmentFile, and paths.
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now recharge-desk

[Unit]
Description=Recharge Desk Gunicorn
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/recharge-desk/app
EnvironmentFile=-/var/www/recharge-desk/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/var/www/recharge-desk/venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 120 \
    config.wsgi:application
Restart=on-failure

[Install]
WantedBy=multi-user.target
